<?xml version="1.0" encoding="UTF-8" ?>
<COMPATIBILITY_MATRIX>
    <PLUGIN name="block_configurable_reports">
        <PHP version="8.0" level="required"/>
        <PHP_EXTENSIONS>
            <!-- No feedback message: a plain identifier is read from the admin component, not from here,
                 and the freetype check below reports in this plugin's own words when GD cannot draw text,
                 which is also the case when GD is missing altogether. -->
            <PHP_EXTENSION name="gd" level="optional"/>
        </PHP_EXTENSIONS>
        <CUSTOM_CHECKS>
            <CUSTOM_CHECK file="blocks/configurable_reports/lib.php"
                          function="block_configurable_reports_check_freetype" level="optional"/>
        </CUSTOM_CHECKS>
    </PLUGIN>
</COMPATIBILITY_MATRIX>
